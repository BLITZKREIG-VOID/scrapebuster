# ==============================================================================
# ScrapeBuster v3 Pure Layer 3 Full Offense — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Phase 1 Active Runtime Configuration
# ------------------------------------------------------------------------------

# Required: Authoritative target origin to forward requests to (no default fallback permitted)
SB_UPSTREAM_ORIGIN=http://127.0.0.1:8001

# Required: Public external base URL for proxy routing and decoy linking (PRD PR-2)
SB_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional: JSON list of runtime configurable decoy honey-routes (default: [])
SB_TRAP_PATHS=["/hidden/decoy", "/internal/audit"]

# Optional: Path prefix for dedicated decoy API responses (default: "")
SB_TRAP_API_PATH=/api/v1/decoy

# Optional: Path to local SQLite forensic database (default: sb.db)
SB_DB_PATH=sb.db

# Optional: Directory for local runtime state and artifacts (default: runtime/)
SB_RUNTIME_DIR=runtime/

# Phase 2: Adaptive AR Classifier & Dynamic Router Configuration (PRD M2)
# SB_MUTATION_MODE: 'adaptive' (default) evaluates trust score against baseline; 'always' forces sandbox for all requests
SB_MUTATION_MODE=adaptive
# SB_AR_ALPHA: EMA smoothing factor alpha for per-route asset ratio baseline (default: 0.2)
SB_AR_ALPHA=0.2
# SB_AR_ANOMALY_STREAK: Number of consecutive zero-AR API requests triggering sticky sandbox lock (default: 20)
SB_AR_ANOMALY_STREAK=20
# SB_TRUST_THRESHOLD: Trust score threshold (0-100) above which mature sessions take FAST_PATH bypass (default: 70.0)
SB_TRUST_THRESHOLD=70.0
# SB_BASELINE_MIN_SAMPLES: Minimum samples required before a route baseline is mature (default: 10, cold start fail-offensive)
SB_BASELINE_MIN_SAMPLES=10
# SB_REDIS_URL: Optional Redis URL for shared trust/baseline state (default empty: embedded durable SQLite)
SB_REDIS_URL=

# Worker 1 / FR1.2: Path to offline ASN lookup database/mapping table (default: "")
# If empty or IP is private/loopback, ASN resolves to None with asn_status "unavailable" or "loopback"
SB_ASN_DB_PATH=

# Worker 1 / FR1.2: Trusted proxy IPs/CIDRs for upstream TLS termination boundary (default: "")
# Client-supplied TLS headers are stripped unless socket IP strictly matches trusted proxy
SB_TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.0/8

# Worker 1 / FR1.4: Asynchronous background telemetry queue batch drain size (default: 50)
SB_TELEMETRY_BATCH_SIZE=50

# Worker 1 / FR1.4: Asynchronous background telemetry flush interval in milliseconds (default: 100)
SB_TELEMETRY_FLUSH_INTERVAL_MS=100


# ------------------------------------------------------------------------------
# Future PRD Environment Knobs (NOT YET SUPPORTED IN PHASE 1)
# Documented for reference; attempting to enable these will have no effect.
# ------------------------------------------------------------------------------

# Phase 2: Active traffic classification engine & adaptive EMA router
# SB_CLASSIFIER_MODE=heuristic

# Phase 3/4: LLM-assisted correlation and analysis provider
# OPENAI_API_KEY=your-api-key-here
# SB_LLM_PROVIDER=openai

# Phase 5: S3 Provenance Evidence Vault (Phase 1 uses local SQLite forensic_ledger)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1
# SB_VAULT_S3_BUCKET=your-provenance-vault-bucket
