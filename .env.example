# ==============================================================================
# ScrapeBuster v3 Pure Layer 3 Full Offense — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Phase 0 Active Runtime Configuration (Supported)
# ------------------------------------------------------------------------------

# Required: Authoritative target origin to forward requests to (no default fallback permitted)
SB_UPSTREAM_ORIGIN=http://127.0.0.1:8001

# Required: Public external base URL for proxy routing and decoy linking (PRD PR-2)
SB_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional: JSON list of runtime configurable decoy honey-routes (default: [])
SB_TRAP_PATHS=["/hidden/decoy", "/internal/audit"]

# Optional: Path prefix for dedicated decoy API responses (default: "")
SB_TRAP_API_PATH=/api/v1/decoy

# Optional: Path to local SQLite forensic database (default: sb.db)
SB_DB_PATH=sb.db

# Optional: Directory for local runtime state and artifacts (default: runtime/)
SB_RUNTIME_DIR=runtime/

# Optional: Offensive mutation mode (sandbox, default)
SB_MUTATION_MODE=sandbox


# ------------------------------------------------------------------------------
# Future PRD Environment Knobs (NOT YET SUPPORTED IN PHASE 0)
# Documented for reference; attempting to enable these will have no effect.
# ------------------------------------------------------------------------------

# Phase 1: TLS fingerprinting and latency injection (Not yet supported)
# SB_TLS_FINGERPRINTING=false
# SB_LATENCY_INJECTION=false

# Phase 2: Active traffic classification engine (Not yet supported in Phase 0 sandbox)
# SB_CLASSIFIER_MODE=heuristic

# Phase 3/4: LLM-assisted correlation and analysis provider (Not yet supported)
# OPENAI_API_KEY=your-api-key-here
# SB_LLM_PROVIDER=openai

# Phase 5: S3 Provenance Evidence Vault (Not yet supported; Phase 0 is local SQLite)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1
# SB_VAULT_S3_BUCKET=your-provenance-vault-bucket
